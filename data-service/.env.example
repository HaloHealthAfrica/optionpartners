# Data Integration Service Configuration

# Server
PORT=4000
NODE_ENV=development
API_KEY=your-data-service-api-key

# TwelveData (primary stock/candle provider)
TWELVE_DATA_API_KEY=your-twelve-data-key
TWELVE_DATA_RATE_LIMIT=800

# Unusual Whales (primary options intelligence)
UNUSUAL_WHALES_API_KEY=your-uw-key
UNUSUAL_WHALES_RATE_LIMIT=120

# Polygon (tertiary fallback)
POLYGON_API_KEY=your-polygon-key
POLYGON_RATE_LIMIT=5

# CBOE (VIX / term structure — free, no key needed)
CBOE_RATE_LIMIT=10

# FRED (macro data — free)
FRED_API_KEY=your-fred-key

# Redis (primary cache)
REDIS_URL=redis://localhost:6379

# Postgres (snapshot persistence)
DATABASE_URL=postgresql://localhost:5432/data_service

# Logging
LOG_LEVEL=info
